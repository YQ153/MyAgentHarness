# 复制本文件为 .env 后填写真实值
#
# 没有「默认工作空间」这一项：会话的根在**创建会话时**决定——选了目录就用它，没选就由
# 应用在 SESSIONS_ROOT 下按会话 ID 建一个专属目录。旧版本里的 WORKSPACE /
# WORKSPACE_ROOTS / WORKSPACE_ANYWHERE 已不存在；`.env` 里若还留着它们，启动时会以
# WARNING 点名列出（见 AppConfig.warn_unknown_env_keys），不会让服务起不来。

# ---------------- 模型 ----------------
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEFAULT_MODEL=deepseek-flash

# 多 Provider（可选）：填了 Key 才会在模型下拉框里出现对应别名，
# 否则该 provider 不注册，避免点了才报「缺少 xxx_API_KEY」
# OPENAI_API_KEY=sk-...
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_API_BASE=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# 本地 Ollama（可选）：显式设置地址即注册；需自行安装 langchain-ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# 工具调用场景建议保持 0，避免参数漂移
LLM_TEMPERATURE=0.0
LLM_TIMEOUT=60.0
LLM_MAX_RETRIES=2

# ---------------- 安全执行 ----------------
# disabled：execute 不可用（默认，推荐先走这档）
# local：宿主机直跑 shell，仅限本机 CLI 开发
# sandbox：在沙箱内执行 shell，隔离强度由 SANDBOX_TIER 决定（Tier 0 / 1 / 2 已实现；
# docker 档位不在 auto 候选内，需显式指定）
# 注意：local / sandbox 下工具级文件权限会被显式停用——execute 走 shell，可绕过
# read_file / write_file 的路径检查，deepagents 因此拒绝该组合。敏感路径拒绝只在
# disabled 档位生效；详见 README 第五章。
EXECUTION_MODE=disabled
SHELL_TIMEOUT=120
SHELL_MAX_OUTPUT_BYTES=100000

# 传入子进程的环境变量白名单（逗号分隔），其余一律不传。
# WHY 白名单：宿主机环境常含 *_API_KEY、云凭证、USERPROFILE，黑名单补不全。
# 大小写无需在意，过滤时两侧都按大写比较。
# SANDBOX_ENV_ALLOWLIST=PATH,SYSTEMROOT,TEMP,TZ

# ---------------- 护栏 ----------------
# 单次运行的最大模型调用次数，防止模型陷入无限循环
MAX_MODEL_CALLS_PER_RUN=60
RECURSION_LIMIT=100

# ---------------- 路径 ----------------
# 【可选】没绑定工作空间的会话，其专属目录的父目录；每个会话一个子目录（名字就是会话 ID）。
#
# 默认派生为 <数据目录>/sessions（数据目录 = DB_PATH 的所在目录）。WHY 跟着数据目录走：
# 会话的检查点、审计与用量都在那个库里，把「会话专属目录」放在别处会让「备份/搬迁只需要
# 搬一个目录」不再成立。
#
# WHY 需要它：不绑定工作空间的会话同样需要一个文件根——Agent 的文件工具、沙箱挂载根、
# 附件目录与知识库索引都以它为准。没有这一项，那些会话就没有地方落文件。
#
# SESSIONS_ROOT=D:/agent-sessions

# **全局**长期记忆：人工维护、Agent 只读、对**全部会话**生效（跨工作区共享）。
# 它不必位于任何工作区内部——应用会把它以只读挂载 /global/AGENTS.md 交给 Agent，
# 因此 Agent 读得到、引用得到，但改不动（改它请直接编辑这个文件）。
# 配置了它之后，各会话根下的 AGENTS.md 不再作为来源（避免两处说法冲突）。
# 注释掉即不用全局记忆，改用 <会话根>/AGENTS.md（工作区自带的那份，随项目走）。
# 文件不存在时只记 WARNING 并跳过加载，不会让启动失败。
# MEMORY_FILE=D:/projects/my-app/AGENTS.md

# 单文件 SQLite：检查点、会话元数据、审计、用量与 Agent 自写的长期记忆
# （/memories/，按用户隔离）都在这里，备份/搬迁只需要搬这一个文件。
DB_PATH=./.data/agent.db
# 技能目录，按顺序查找。**顺序有语义：越靠后优先级越高**（同名技能由后面的来源覆盖
# 前面的）——因此通用技能目录排在前（低优先级），用户用同名技能即可覆盖它。
# 顺序反过来会让随产品交付的技能永远赢，而「我改了却不生效」不会有任何报错。
#
# 注释掉即按默认派生，三项（**顺序即优先级**）：
#   1. 通用技能：<应用目录>/skills/builtin（每个场景都能用）；
#   2. 场景预设：<应用目录>/skills/presets/<当前场景>/（只有绑定该场景的会话才用）；
#   3. 用户技能库：<工作区>/.harness/skills（用户可改，同名时覆盖上面两者）。
# 前两项在工作区之外，由程序挂虚拟路径后读取。
#
# 多目录用**路径分隔符**：Windows 是 `;`、POSIX 是 `:`（与 PATH 同口径）——不能用
# 逗号，因为路径本身可能含逗号，按逗号切会把一个目录拆成两个不存在的目录。
# SKILL_DIRS=./skills/builtin;D:/projects/my-app/skills
# 也接受 JSON 数组：SKILL_DIRS=["./skills/builtin","D:/projects/my-app/skills"]

# 场景预设目录：每个一级子目录是一个场景（含 preset.toml 与可选技能包，场景决定某个会话
# 用哪些技能）。注释掉即用随应用交付的 <应用目录>/skills/presets。
# 覆盖它适用于「部署里换一套团队自己的场景集」，与 SKILL_DIRS 同一动机。
# PRESETS_DIR=D:/company/presets

# ---------------- 会话 ----------------
# 会话列表标题的字符上限，超出部分以省略号截断
THREAD_TITLE_MAX_CHARS=24

# 手动改名的字符上限。与上面分开：自动标题只为列表可读（很短），而手写标题
# 常带上下文（「排查登录超时 - 2026Q3」），用 24 字符卡手工输入等于逼用户起
# 一个没信息量的名字。超长会直接报错，不会静默截断。
THREAD_RENAME_MAX_CHARS=120

# ---------------- 工具扩展（自定义工具 / MCP） ----------------
# 自定义工具模块（点分路径）。逗号分隔或 JSON 数组均可：
#   CUSTOM_TOOL_MODULES=myapp.tools.weather,myapp.tools.translate
#   CUSTOM_TOOL_MODULES=["myapp.tools.weather","myapp.tools.translate"]
# 模块需提供 TOOLS（工具列表）或 register_tools(registry) 函数，二者之一；
# 也可以声明第二个参数 register_tools(registry, config) 以拿到配置对象——
# 需要按配置决定「注册哪些工具、用什么阈值」的模块必须用这种写法（.env 里的值
# 只进配置对象、不进进程环境变量，模块自己读 os.environ 是读不到的）。
# 导入失败会让服务启动失败，因为「少了工具」只会在某次对话里才被发现。
#
# 内置的联网工具就是一个这样的模块，默认不加载。启用：
#   CUSTOM_TOOL_MODULES=web_tools
# 加载后抓取工具立即可用，检索工具则需要下面选了 provider。

# MCP 总开关；未配置任何 server 时取何值都不会产生连接
MCP_ENABLED=true

# MCP 服务器清单，JSON 数组。name 必须唯一，且只允许 [A-Za-z0-9_-]：
# - stdio 传输：必须提供 command（args / env / cwd 可选）。
#   env 不继承宿主环境，需要什么就写什么，避免宿主机 API Key 泄漏给第三方进程。
# - sse / streamable_http / websocket 传输：必须提供 url（headers 可选）。
# 示例（stdio）：
# MCP_SERVERS=[{"name":"filesystem","transport":"stdio","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","/tmp"]}]
# 示例（远程 HTTP）：
# MCP_SERVERS=[{"name":"remote","transport":"streamable_http","url":"https://mcp.example.com/mcp","headers":{"Authorization":"Bearer xxx"}}]

# 为 MCP 工具名加「服务器名_」前缀，让两台服务器提供同名工具时在注册期就报错
MCP_TOOL_NAME_PREFIX=true
# 单个 MCP server 拉取工具清单的超时秒数（stdio server 可能既不退出也不响应握手）
MCP_LOAD_TIMEOUT_SECONDS=15
# 某台服务器加载失败时是否阻断启动；默认 false 表示降级并写 ERROR 日志，
# 失败状态可在 GET /api/tools 查看
MCP_FAIL_FAST=false

# 是否把内置工具（read_file / execute 等）的调用也写入审计；默认关闭，
# 内置命令执行本身已由人工审批留痕
TOOL_AUDIT_BUILTIN=false

# ---------------- 联网工具（需 CUSTOM_TOOL_MODULES=web_tools） ----------------
# 检索 provider：
#   none     默认，不注册检索工具
#   tavily   托管检索服务，需要密钥
#   searxng  自建元搜索，需要地址、不需要密钥（实例需开启 JSON 输出）
WEB_SEARCH_PROVIDER=none
# WEB_SEARCH_API_KEY=tvly-...
# searxng 必须填写；tavily 留空则用官方地址
# WEB_SEARCH_BASE_URL=http://127.0.0.1:8888
WEB_SEARCH_TIMEOUT_SECONDS=15
# 结果条数上限：检索结果会整体进入上下文，条数不设限会挤掉对话历史
WEB_SEARCH_MAX_RESULTS=5

# 抓取：地址会先过出站安全校验——拒绝内网、回环、链路本地、组播地址与云元数据
# 端点（防 SSRF），并按下面的跳数上限逐跳复检重定向
WEB_FETCH_TIMEOUT_SECONDS=20
WEB_FETCH_MAX_CHARS=20000
WEB_FETCH_MAX_REDIRECTS=3
# 出站请求的 User-Agent，留空用内置默认值
# WEB_USER_AGENT=

# ---------------- 嵌入后端（知识库的语义检索能力） ----------------
# 档位：
#   none          默认，不做嵌入；知识库退化为关键词检索（这是设计上的降级，不是故障）
#   openai-compat 调用兼容 POST /v1/embeddings 的服务（OpenAI / TEI / Ollama / 云厂商）；
#                 容器内加载模型走这一档——应用不做容器编排，只管往一个地址发请求
#   subprocess    本机自托管：在独立 venv 内拉起瘦服务进程（先跑
#                 python scripts/setup_embed_venv.py），模型能在空闲时被整个回收
EMBEDDING_BACKEND=none
# openai-compat 档位必须提供；地址不含 /v1，由实现拼接
# EMBEDDING_BASE_URL=http://embed:80
# EMBEDDING_API_KEY=
# subprocess 档位的解释器路径；留空用 <数据目录>/embed-venv
# EMBEDDING_PYTHON=
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 向量维度：建表时就要固定，故必须是配置而不是从首次响应里读回来。
# 换模型必须同步改这一项并重建索引，否则插入会因维度不符报错。
EMBEDDING_DIMS=512
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=30
# subprocess 档位的空闲回收秒数；0 表示不回收
EMBEDDING_IDLE_SECONDS=600

# ---------------- 知识库（工作区文档索引与检索） ----------------
# 分块以**字符**计：切分发生在模型之外，这一层拿不到分词器；中英文 token/字符比
# 差异很大，用字符才能给出跨语言一致的行为。
# 重叠必须小于块长，否则切分会原地打转——启动时即校验。
KNOWLEDGE_CHUNK_CHARS=800
KNOWLEDGE_CHUNK_OVERLAP_CHARS=120
# 检索返回的块数上限：结果会整体进入上下文，不设限会挤掉对话历史
KNOWLEDGE_SEARCH_TOP_K=6
# 单文档分块上限：工作区里出现一份几 MB 的日志或生成文件是常事
KNOWLEDGE_MAX_CHUNKS_PER_DOCUMENT=500

# ---------------- HTTP ----------------
# 保持 127.0.0.1。改绑对外地址（如 0.0.0.0）时，启动会打出 ERROR 级「对外暴露风险」
# 告警（config.warn_if_publicly_exposed）。那条告警不是拦路石，而是提醒：服务不再区分
# 调用方，一旦它对非本机可达，任何能访问该地址的客户端都能直接驱动 execute 工具。
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# ---------------- 其余可调参数（值即默认值，需要时取消注释） ----------------
# 这一节覆盖审计归档、运行上限、沙箱档位、工具输出与工作区上限等运维相关开关。
# 全部保持注释即等于使用默认值；改哪一项就把哪一行取消注释。
# AUDIT_ARCHIVE_BATCH_SIZE=500  # 单次归档批次的条数。
# AUDIT_ARCHIVE_DIR=  # 超期审计事件的归档目录。
# AUDIT_ARCHIVE_ENABLED=true  # 清理超期审计事件前是否先导出归档文件。
# AUDIT_RETENTION_DAYS=180  # 审计日志保留天数；超期的记录会被定期清理任务删除。
# AUDIT_RETENTION_INTERVAL_SECONDS=86400  # 保留清理任务的执行间隔（秒）。
# HITL_PENDING_TTL_SECONDS=1800  # 人工审批挂起的最长等待秒数；超期未决策的中断被标记过期。
# LOG_FORMAT=text  # 日志输出格式；``text`` 供本机阅读，``json`` 供采集系统解析。
# MAX_CONCURRENT_RUNS=4  # 全进程允许同时进行的大模型运行数；``0`` 表示不限制。
# RUN_GOVERNANCE_INTERVAL_SECONDS=30  # 运行治理协程的巡检间隔（秒）。
# RUN_MAX_SECONDS=900  # 单轮运行的最长秒数；超时由后台巡检协程强制取消。
# RUN_RATE_LIMIT_MAX_ATTEMPTS=30  # 单个主体在窗口内允许发起的运行数。
# RUN_RATE_LIMIT_WINDOW_SECONDS=60  # 单个主体在窗口内允许发起的运行数。
# RUN_REJECTED_RETRY_AFTER_SECONDS=5  # 被限流或超出并发上限时回给客户端的 Retry-After 秒数。
# SANDBOX_CPU_PERCENT=50  # CPU 占用硬上限百分比（Windows Job Object 生效）。
# SANDBOX_DOCKER_IMAGE=harness-sandbox:latest  # docker 档位的执行镜像；由 scripts/setup_sandbox_image.py 构建。
# SANDBOX_DOCKER_USER=  # docker 档位传给 --user 的值（如 1000:1000）；留空用镜像默认身份。
# SANDBOX_DOCKER_WORKSPACE_READ_ONLY=false  # docker 档位是否只读挂载工作区。
# SANDBOX_MAX_MEMORY_MB=2048  # 单个进程的内存上限（MB）。
# SANDBOX_MAX_OUTPUT_BYTES=100000  # stdout / stderr 各自的截断阈值。
# SANDBOX_MAX_PROCESSES=64  # 活动进程数上限。
# SANDBOX_NETWORK_MODE=none  # 网络模式。
# SANDBOX_REQUIRE_APPROVAL=true  # 沙箱档位下是否仍需人工审批。
# SANDBOX_TIER=auto  # 隔离档位；``auto`` 会落到当前已实现的最高档位。
# SANDBOX_TIMEOUT=120  # 单条命令的超时秒数。
# SANDBOX_WSL_DISTRO=  # WSL 档位使用的发行版名称；``None`` 时自动挑选首个满足要求的发行版。
# TOOL_OUTPUT_MAX_CHARS=200000  # 单个留存文件的字符上限（被截断的工具输出会完整落盘到工作区）。
# TOOL_OUTPUT_RETENTION_PER_THREAD=20  # 每个会话保留的最新工具输出份数，超出后按时间清理旧文件。
# TOOL_RESULT_PREVIEW_CHARS=2000  # 推送给前端的工具结果预览长度上限。
# USAGE_DEFAULT_WINDOW_DAYS=7  # /api/usage 的默认统计窗口天数。
# USAGE_MAX_WINDOW_DAYS=90  # /api/usage 允许查询的最大窗口天数。
# WORKSPACE_FILE_MAX_BYTES=5000000  # 超过此字节数的文件不做文本预览，只回 ``too_large`` 降级标记。
# WORKSPACE_FILE_PREVIEW_CHARS=20000  # 文件面板里文本预览的字符上限（超出截断并在响应里标注）。
# WORKSPACE_LIST_MAX_ENTRIES=500  # 单次列目录返回的最大条目数。
# SESSIONS_ROOT=  # 未绑定工作空间的会话，其专属目录的父目录；留空则按 <数据目录>/sessions 派生。
# ATTACHMENT_MAX_BYTES=2000000  # 单个附件的字节上限；内容会进检查点，不宜放大。
# ATTACHMENT_MAX_PER_THREAD=8  # 单个会话允许保留的附件数上限。
# ATTACHMENT_ALLOWED_MIME_TYPES=image/png,image/jpeg,image/webp,image/gif  # 允许上传的 MIME 白名单。
# VISION_MODEL_ALIASES=openai,anthropic  # 支持图片输入的模型别名；只有这些别名允许带附件发起运行。
# EMBEDDING_BACKEND=none  # 嵌入后端档位：none / openai-compat / subprocess；见上方「嵌入后端」一节。
# EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5  # 嵌入模型标识。
# EMBEDDING_BASE_URL=  # openai-compat 档位的服务地址（不含 /v1）。
# EMBEDDING_API_KEY=  # 嵌入服务密钥；本地服务通常不需要。
# EMBEDDING_DIMS=512  # 向量维度；建表时固定，换模型须同步修改并重建索引。
# EMBEDDING_BATCH_SIZE=32  # 单次嵌入请求的文本条数上限。
# EMBEDDING_TIMEOUT_SECONDS=30  # 单次嵌入往返的超时秒数；处于同步阻塞路径上，不宜过长。
# EMBEDDING_IDLE_SECONDS=600  # subprocess 档位的子进程空闲回收秒数；0 表示不回收。
# EMBEDDING_PYTHON=  # subprocess 档位的解释器路径；留空用 <数据目录>/embed-venv。
# KNOWLEDGE_CHUNK_CHARS=800  # 单个分块的目标字符数。
# KNOWLEDGE_CHUNK_OVERLAP_CHARS=120  # 相邻分块的重叠字符数；必须小于块长。
# KNOWLEDGE_SEARCH_TOP_K=6  # 检索返回的块数上限。
# KNOWLEDGE_MAX_CHUNKS_PER_DOCUMENT=500  # 单个文档允许的分块数上限，超出后截断并记日志。
