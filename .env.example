# 复制本文件为 .env 后填写真实值

# ---------------- 模型 ----------------
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEFAULT_MODEL=deepseek-flash

# 工具调用场景建议保持 0，避免参数漂移
LLM_TEMPERATURE=0.0
LLM_TIMEOUT=60.0
LLM_MAX_RETRIES=2

# ---------------- 安全执行 ----------------
# disabled：execute 不可用（默认，推荐先走这档）
# local：宿主机直跑 shell，仅限本机 CLI 开发
# sandbox：容器内执行，尚未接入
EXECUTION_MODE=disabled
SHELL_TIMEOUT=120
SHELL_MAX_OUTPUT_BYTES=100000

# ---------------- 护栏 ----------------
# 单次运行的最大模型调用次数，防止模型陷入无限循环
MAX_MODEL_CALLS_PER_RUN=60
RECURSION_LIMIT=100

# ---------------- 路径 ----------------
WORKSPACE=./workspace
MEMORY_FILE=./workspace/AGENTS.md
DB_PATH=./.data/agent.db

# ---------------- 会话 ----------------
# 会话列表标题的字符上限，超出部分以省略号截断
THREAD_TITLE_MAX_CHARS=24

# ---------------- HTTP ----------------
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
