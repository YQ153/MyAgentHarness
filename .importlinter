; Layered-architecture contracts.
;
; WHY enforce this automatically: an architectural convention that lives only in
; a document degrades with every "just one more import" -- silently, with no
; warning and no failing test, until the damage is expensive to undo. Turning
; the convention into executable rules makes each violation fail at commit time.
;
; Run: uv run lint-imports
;
; KEEP THIS FILE PURE ASCII. Windows Python reads it with the locale encoding
; (cp936 / cp1252), so a single non-ASCII byte makes lint-imports crash with a
; UnicodeDecodeError unless PYTHONUTF8=1 happens to be set in the environment.

[importlinter]
root_packages =
    agent
    application
    bootstrap
    interfaces
    llm
    runtime

; ---------------------------------------------------------------- contract 1
; The interface layer must reach infrastructure through the application layer,
; never by importing runtime directly. This contract locks in the composition
; root refactor.
[importlinter:contract:interfaces-no-runtime]
name = interfaces must not depend on runtime directly
type = forbidden
source_modules =
    interfaces
forbidden_modules =
    runtime
; Direct imports only: interfaces -> application -> runtime is the normal
; transitive path of the layering. Forbidding it too would contradict contract 4,
; which allows application to depend on runtime.
allow_indirect_imports = True

; ---------------------------------------------------------------- contract 2
; llm only maps a name to a model instance; it must not reach back into the
; agent assembly layer for profile registration.
[importlinter:contract:llm-no-agent]
name = llm must not depend on agent
type = forbidden
source_modules =
    llm
forbidden_modules =
    agent

; ---------------------------------------------------------------- contract 3
; runtime is the infrastructure leaf: it must not depend on any layer above it,
; nor on the assembly layer.
[importlinter:contract:runtime-is-leaf]
name = runtime must not depend on application / interfaces / agent / llm / bootstrap
type = forbidden
source_modules =
    runtime
forbidden_modules =
    application
    interfaces
    agent
    llm
    bootstrap

; ---------------------------------------------------------------- contract 4
; The application layer describes business behaviour and must not depend on the
; interface layer or the assembly layer.
[importlinter:contract:application-no-upper]
name = application must not depend on interfaces / bootstrap
type = forbidden
source_modules =
    application
forbidden_modules =
    interfaces
    bootstrap

; ---------------------------------------------------------------- contract 5
; agent assembles the graph and must not depend on application / interfaces /
; bootstrap.
[importlinter:contract:agent-no-upper]
name = agent must not depend on application / interfaces / bootstrap
type = forbidden
source_modules =
    agent
forbidden_modules =
    application
    interfaces
    bootstrap

; ---------------------------------------------------------------- contract 6
; The assembly layer sits above the business layers: interface adapters may call
; it to build objects, but business and infrastructure layers must not depend on
; it -- otherwise the tight coupling spreads from the assembly point through the
; whole codebase.
[importlinter:contract:bootstrap-not-depended-by-lower]
name = bootstrap must not be depended on by application / agent / llm / runtime
type = forbidden
source_modules =
    agent
    application
    llm
    runtime
forbidden_modules =
    bootstrap
allow_indirect_imports = True

; ===========================================================================
; Root-level modules are NOT covered here, and cannot be. import-linter only
; accepts packages as analysis roots: root_packages entries must be directories
; with __init__.py, so listing a single-file module fails with
;   "'config' is a module, not a package."
; and referencing one from a contract (after putting it back) fails with
;   "Module 'config' does not exist."
; Both verified against import-linter 2.15 / grimp 3.17.
;
; The affected modules are config / text_utils / thread_utils / web_safety /
; knowledge_runtime / knowledge_tools / web_tools / main. Their boundaries are
; enforced instead by tests/test_root_module_contract.py, which runs in the same
; CI job as `uv run lint-imports`.
;
; WHY this note lives here: the obvious "fix" for a missing rule is to append
; the module to root_packages, which only yields a confusing tool error. This
; note exists so that dead end is not re-explored. The role of each root-level
; module (neutral leaf / service handle / tool plugin / entry point) and the
; reasoning behind it are recorded in docs/architecture/.
;
; ---------------------------------------------------------------------------
; In-package boundaries are NOT covered here either: every contract above
; compares packages with each other, so module-to-module dependencies inside a
; single package (application/ is a flat package of 29 modules) are invisible.
; Two guards cover that gap, in the same CI job:
;
;   tests/application/test_layer_purity_contract.py
;       contract modules (dto / errors / events / ports /
;       audit_recorder) must not import service modules -- the
;       reverse direction would mean the contract layer absorbed business flow.
;
;   tests/application/test_runtime_port_contract.py
;       the exact set of runtime symbols application/ may import directly
;       (portable implementations go through application/ports.py protocols;
;       stateless helpers, data carriers and exceptions stay whitelisted).
;
; Rationale for both: docs/architecture/ (Q8 and Q11 of the governance plan).
